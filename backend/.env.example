# PAVHAN backend configuration
# ---------------------------------------------------------------
# Optional. When set, listing generation / image understanding /
# storytelling are routed through the Claude API for best quality.
# When absent, PAVHAN falls back to its built-in on-device engine
# (colour-science vision + Hinglish NLP) so the demo always works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Enables server-side audio transcription (OpenAI Whisper
# compatible endpoint). Without it the browser Web Speech API is used.
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

PAVHAN_DB_URL=sqlite:///./pavhan.db
PAVHAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAVHAN_SECRET_KEY=change-me-in-production
